<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Desconto_Entre_Zero_e_Cem</fullName>
    <active>true</active>
    <description>O percentual de desconto deve estar entre 0 e 100.</description>
    <errorConditionFormula>
        OR(
            Valor_do_Desconto__c &lt; 0,
            Valor_do_Desconto__c &gt; 100
        )
    </errorConditionFormula>
    <errorMessage>O desconto deve estar entre 0% e 100%.</errorMessage>
</ValidationRule>
